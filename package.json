{
  "name": "devnullx-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "cf:build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "cf:start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run",
    "test:rendered": "npm run cf:build && node --test tests/rendered-html.test.mjs",
    "lint": "biome lint app"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.32",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module"
}
